# Smart Assistive Cap — Backend environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The backend reads variables directly from the environment
# (e.g. shell exports or `node --env-file=.env server.js`).

# HTTP server (existing)
PORT=3000

# CORS: comma-separated allowed origins, e.g.
#   CORS_ORIGIN=https://caretaker-interface-demo-frontend.vercel.app
# Credentialed (cookie) requests git add .git add .are allowed, so a wildcard origin is never used.
# When unset the backend fails CLOSED and only allows the local dev origins:
#   http://localhost:5500, http://127.0.0.1:5500
CORS_ORIGIN=

# ── Authentication (Stage 2 — caretaker accounts) ──────────────────
# Server-side sessions stored in PostgreSQL (sessions.token_hash). The browser
# holds only an HttpOnly cookie with the raw session token.
#
# Session lifetime in milliseconds (default 604800000 = 7 days).
SESSION_TTL_MS=604800000
# Cookie name used for the session. HttpOnly, SameSite=Lax; Secure is enabled
# automatically in production (NODE_ENV=production). Set to true to force it.
SESSION_COOKIE_NAME=bg_session
COOKIE_SECURE=false
# bcrypt cost factor (4–15, default 10).
BCRYPT_ROUNDS=10
# Login/register rate limiting (per IP). Default 20 attempts per 15 minutes.
AUTH_RATE_MAX=20
AUTH_RATE_WINDOW_MS=900000

# ── PostgreSQL (optional, Stage 1 database foundation) ──────────
# The database is a FOUNDATION ONLY in this stage — the REST API does not use
# it yet and runs fine without it. Only the migration system and future
# features (auth, persistence) require DATABASE_URL.
#
# Example: postgres://user:password@localhost:5432/caretaker
DATABASE_URL=

# ── Device authentication (Stage 4 — blind-client pairing) ────────
# Device `last_seen` writes are throttled to reduce database churn. This is the
# minimum interval in milliseconds between `last_seen_at` updates for the SAME
# device, tracked in memory (default 300000 = 5 minutes).
DEVICE_TOUCH_THROTTLE_MS=300000

# ── MQTT (HiveMQ Cloud) ─────────────────────────────────────────
# MQTT is OPTIONAL. If MQTT_BROKER_URL is missing, the backend runs
# the REST API without MQTT and logs a warning.
#
# HiveMQ Cloud native TLS endpoint uses the mqtts:// scheme.
# Example (replace with your HiveMQ Cloud cluster details):
# MQTT_BROKER_URL=mqtts://xxxxxxxx.s2.eu.hivemq.cloud:8883
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# Optional. Auto-generated as caretaker-backend-<random> if left empty.
MQTT_CLIENT_ID=

# ── Wall-E AI (NVIDIA NIM) ─────────────────────────────────
# Required for Wall-E AI assistant. Get a key from build.nvidia.com.
NVIDIA_API_KEY=

# Model fallback order (primary → fallback 1 → fallback 2).
WALLE_MODEL_PRIMARY=nvidia/nemotron-3.5-lightning-30b-a3b
WALLE_MODEL_FALLBACK_1=nvidia/nemotron-3-super-120b-a12b
WALLE_MODEL_FALLBACK_2=deepseek-ai/deepseek-v4-flash-0731

# Per-model request timeout in milliseconds.
WALLE_AI_TIMEOUT_MS=10000

# Maximum character length for Wall-E chat messages (default 1000).
WALLE_MAX_MESSAGE_LENGTH=1000

# ── Wall-E conversation history (bounded, in-memory + DB-backed) ──
# Conversation turns per session are held in memory first (the hot path) and
# mirrored to PostgreSQL in the background. After a restart, non-expired
# sessions are rehydrated from the database. All values are rebuilt lazily.

# Maximum user + assistant turns retained per session (default 20).
WALLE_SESSION_MAX_TURNS=20

# Session idle TTL in milliseconds. Sessions idle longer than this are pruned
# lazily on the next conversation operation (default 86400000 = 24h).
WALLE_SESSION_TTL_MS=86400000

# Maximum number of tracked sessions. The oldest inactive sessions are dropped
# lazily beyond this limit (default 100).
WALLE_MAX_SESSIONS=100

# ── Telemetry persistence (Stage 5 — bounded, best-effort) ────────────
# Events and runtime state are written to PostgreSQL synchronously (or
# fire-and-forget) from the memory hot path. When the database is unavailable,
# writes are queued in a bounded FIFO (TELEMETRY_QUEUE_MAX) with head-of-line
# retry. GET /api/events returns at most EVENTS_WINDOW_MAX rows from the
# database, falling back to the in-memory window when the database is down.

# Bounded window returned by GET /api/events (default 100).
EVENTS_WINDOW_MAX=100

# Maximum queued database writes when PostgreSQL is unreachable (default 500).
# The oldest queued item is dropped on overflow.
TELEMETRY_QUEUE_MAX=500

# ── On-demand heart-rate monitoring (per-device, backend-driven) ─────────
# The backend issues MQTT GET_HEART_RATE commands to each registered device on a
# normal cadence, switches that device to a high-frequency cadence after any
# abnormal reading (below 60 or above 100 BPM), and returns to normal after
# HEART_RATE_RECOVERY_NORMAL_READINGS consecutive normal readings. Values are
# read at boot. Automatic requests never overlap a pending request; a manual
# caretaker request that coincides with one joins it instead of publishing twice.

# Normal per-device automatic cadence (default 300000 = 5 minutes).
HEART_RATE_NORMAL_INTERVAL_MS=300000
# High-frequency cadence after an abnormal reading (default 120000 = 2 minutes).
HEART_RATE_HIGH_INTERVAL_MS=120000
# Consecutive normal readings (any source) needed to recover to normal cadence.
HEART_RATE_RECOVERY_NORMAL_READINGS=3
# How long the backend waits for a device to answer a GET_HEART_RATE request
# before abandoning it (no response, or no finger on the MAX30102, times out).
HEART_RATE_REQUEST_TIMEOUT_MS=15000
# Bounded in-memory history window per device (the DB keeps the full history).
HEART_RATE_HISTORY_WINDOW=200

# ── Stage 8B: production hardening ──────────────────────────────────────
# REQUIRE_AUTH_FOR_READS gates the read endpoints that are public by default
# (GET /api/events, /api/location, /api/events/stream, /api/health,
# /api/buzzer) behind an authenticated CARETAKER session. DEFAULT IS OFF to
# preserve the demo experience (the public Blind Client console and the
# unauthenticated dashboard depend on it). Production deployments should enable
# it. Scoped reads (?blindUserId=) always require the caretaker anyway.
REQUIRE_AUTH_FOR_READS=false

# Concurrent SSE connections per instance before new streams are rejected with
# 503 (default 30). Bounds per-instance memory; not a global limit.
SSE_MAX_CLIENTS=30

# Per-device REST write rate limits (defaults are well above normal paired
# sensor telemetry; MQTT ingestion is a separate pipeline and is unaffected).
# Limits are keyed on the authenticated device identity, not on the client IP.
# A device over its limit receives 429.
DEVICE_WRITE_RATE_WINDOW_MS=60000
DEVICE_EVENTS_RATE_MAX=120
DEVICE_LOCATION_RATE_MAX=120
DEVICE_BUZZER_RATE_MAX=60

# Trusted reverse proxy hops for req.ip (X-Forwarded-For interpretation).
# Leave EMPTY unless the backend sits behind a proxy/Vercel deployment is
# chained onto. Accepted values: a positive integer hop count, or one of
# loopback | linklocal | uniquelocal. Arbitrary or boolean values are rejected
# and the backend falls back to no proxy trust. Rate limiting stays in-memory
# and per-instance — it is never globally distributed.
TRUST_PROXY=