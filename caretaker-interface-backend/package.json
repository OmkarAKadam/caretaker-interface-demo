{
  "name": "caretaker-interface-backend",
  "version": "1.0.0",
  "description": "Backend for the Smart Assistive Cap Caretaker Console",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:env": "node --env-file-if-exists=.env server.js",
    "migrate": "node --env-file-if-exists=.env db/migrate.js",
    "migrate:status": "node --env-file-if-exists=.env db/migrate.js --status",
    "test:auth": "node --env-file-if-exists=.env scripts/test-auth.js",
    "test:stage3": "node --env-file-if-exists=.env scripts/test-stage3.js",
    "test:stage4": "node --env-file-if-exists=.env scripts/test-stage4.js"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mqtt": "^5.15.2",
    "pg": "^8.23.0"
  }
}
